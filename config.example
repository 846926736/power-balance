# 续航天平 PowerBalance 配置文件 — 模块作者：酷安：一颗初心
# 保存后服务会在下一轮轮询自动重读，无需重启。
# 未知键、非法值都会被忽略并回退到默认值。

# 总开关：1=启用，0=停用（停用时会自动还原所有已改设置）
enabled=1

# 模式：
#   battery = 电量低且未充电时省电，回升或充电后还原（默认）
#   always  = 一直省电，直到改回别的模式
#   off     = 什么都不做
mode=battery

# 档位（省电力度）：
#   light    = 轻度：最高频降约 10%
#   balanced = 均衡：小/中核降到约 65%，大核留到约 75%，可用时换 conservative 调度
#   extreme  = 激进：频率压到最低档，可用时切 powersave 调度
level=balanced

# battery 模式进入省电的电量阈值（5-80）。
# 退出条件：电量回升到 阈值+5 或开始充电（滞回，避免边界抖动）。
threshold=30

# 息屏省电：1=息屏时也应用省电（无视电量与充电状态），0=只按电量规则。
# 适合晚上挂机、常亮时间少的用法；后台下载/同步会变慢，默认 0。
screen_off_save=0

# 是否切换 CPU 调度器：1=省电时切 conservative/powersave，0=只降频不切调度。
# 说明：调度器决定 CPU 多快升频。开启后省电时换成保守/省电型调度器，
# 更省电但升频更慢、响应稍迟钝；关闭（默认，推荐）只限制最高频率，
# 调度器保持系统原样，游戏等重负载表现更稳。不确定就保持 0。
gov_switch=0

# 高温保护：1=电池温度 >=45C 时自动切到激进档压频护电池，<43C 恢复。
# 高温保护优先于排除名单（护电池是硬约束）；默认 1。
thermal_boost=1

# 低电量加深：1=电量 <=15% 时自动把当前档位升一档（均衡 -> 激进），
# >=20% 恢复（滞回）。充电或排除名单应用前台时不生效；默认 1。
batt_boost=1

# GPU 限频：1=省电时同步限制 GPU 最高频率（轻度 90% / 均衡 70% /
# 激进压到最低档并把最低频率下探），条件结束按原值还原。
# 走标准 devfreq GPU 接口，机型无关：自动识别高通 kgsl/adreno、Mali、
# Exynos g3d、MTK gpufreq、Imagination 等主流命名；GPU 总线/内存类设备
# （名字含 bus/bw/ddr/llcc/mem 等）绝不碰。识别不到的机型自动跳过。
# GPU 也在备份-白名单-还原链路内，可放心开关；默认 1。
gpu_save=1

# GPU 设备手动指定（可选，留空=自动识别）：
# 自动识别不到 GPU 的机型，把 /sys/class/devfreq/ 下设备目录名填在这里，
# 逗号分隔，支持通配符。手动指定的设备信任用户，会覆盖自动排除规则。
# 例：gpu_devices=13000000.mali          （精确设备名）
#     gpu_devices=*kgsl*,*mali*          （通配符，多个）
gpu_devices=

# 前台排除名单（空格分隔的包名）：这些 App 在前台时绝不降频省电，
# 若已处于省电状态会立即还原，保证满性能。
# 例：exclude=com.tencent.tmgp.supercell.clashofclans
# 直接把想保性能的 App 包名写在这里，可填多个。
exclude=

# extreme 档是否真的下线部分大核：1=允许，0=不允许。
# 个别机型关核可能影响基带/WiFi 稳定性，默认 0。
core_off=0

# 轮询间隔秒数（5-3600）。检查一次的代价极小（纯 sysfs 读取），不建议低于 30。
# 服务自适应：未激活且电量远高于阈值时自动拉长到 3 倍，靠近阈值自动恢复。
poll=60

# service.log 自动截断到的行数（10-5000）
log_lines=500

# 统计：累计省电时长与进入次数保存在模块目录 stats 文件，WebUI 只读显示。
# 统计使用系统 uptime 计时，不受手动修改系统时钟影响；升级不清零。

# 提示：管理器里的「执行操作」按钮 = 总开关切换（开 <-> 关），停用即自动还原。
# 若日志出现 drift 字样，说明 ROM 温控/调度覆盖了本模块的值，属正常现象。
